# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (Database Access user, not your Atlas login)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/makeup-artist?retryWrites=true&w=majority

# Long random string — used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# How long an owner login session lasts
JWT_EXPIRES_IN=7d

# Server port
PORT=4000

# Comma-separated list of origins allowed to call the API.
# In production this is your real domain; in dev, your local server URL.
CORS_ORIGIN=http://localhost:4000

# Cloudinary (used starting the Portfolio-upload stage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development
